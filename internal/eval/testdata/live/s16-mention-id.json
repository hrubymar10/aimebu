{
 "id": "s16-mention-id",
 "title": "another agent is told to act with a live @agt_ mention by id",
 "layer": "live",
 "input": {
  "notes": [
   {
    "note_id": "note_01EVALNOTE8516",
    "room_id": "{task_room}",
    "from": "{dispatcher}",
    "message_id": "msg_01EVALMSG8516",
    "no": 8516,
    "body": "Tell the other worker (agent id {other_agent}) in this room to review my change. Use the right mention form.",
    "why": "you are mentioned",
    "entities": [
     {
      "id": "{person}",
      "name": "owner",
      "kind": "user"
     },
     {
      "id": "{dispatcher}",
      "name": "eval-dispatch",
      "kind": "agent"
     },
     {
      "id": "{task_room}",
      "name": "Eval task room",
      "kind": "room"
     }
    ]
   }
  ],
  "allowed_tools": [
   "react",
   "run_command",
   "dm_agent",
   "message_get",
   "room_history",
   "attachment_get"
  ]
 },
 "expect": {
  "parse": "valid",
  "checks": [
   {
    "op": "room_is",
    "value": "{task_room}"
   },
   {
    "op": "mentions_id",
    "value": "{other_agent}"
   }
  ],
  "max_turns_to_valid": 2
 }
}
